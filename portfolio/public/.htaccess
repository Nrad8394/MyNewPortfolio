# Security headers. Next's headers() option does nothing under `output: "export"`,
# so Apache has to set these.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Only send HSTS over HTTPS, and only once you are sure TLS works on every subdomain.
  <If "%{HTTPS} == 'on'">
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  </If>
</IfModule>

# Do not serve dotfiles or env files even if one is uploaded by mistake.
<FilesMatch "^\.(env|git|htpasswd)|\.(env|pem|key|p12|pfx)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ensure directory browsing is disabled but allow access to files
  Options -Indexes +FollowSymLinks

  # 1️⃣ If a .html file exists, serve it instead of a folder with the same name
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # 2️⃣ Remove trailing slashes if they exist (prevents / being added)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} /$
  RewriteRule ^(.+)/$ $1 [R=301,L]

  # 3️⃣ Allow access to existing files and directories (prevents infinite loops)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4️⃣ Rewrite requests to .html for all non-existing files & directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.html$
  RewriteRule ^(.*)$ $1.html [L]

  # 5️⃣ Serve .html files directly and prevent 403 errors
  <FilesMatch "\.html$">
    Require all granted
  </FilesMatch>

  # 6️⃣ Custom error pages
  ErrorDocument 404 /404.html
  ErrorDocument 500 /error.html
</IfModule>