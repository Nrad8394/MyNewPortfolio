# Copy to .env.local and fill in. Both .env and .env.local are gitignored.
#
# IMPORTANT: this app is a STATIC EXPORT served from cPanel/Apache. Every value
# below is compiled into the JavaScript bundle and is readable by any visitor.
# There is no server here, so NOTHING in this file is private.

# OpenRouter key for the chat widget, called directly from the browser.
# This key WILL be public. If you set it:
#   - put a HARD CREDIT LIMIT on it at https://openrouter.ai/settings/keys
#   - use a key dedicated to this site so rotating it breaks nothing else
# Leave blank to disable the chat widget; it hides itself and the rest of the
# site works normally.
NEXT_PUBLIC_OPENROUTER_API_KEY=

# EmailJS identifiers. Browser-visible by design -- these are not secrets.
# Dashboard: https://dashboard.emailjs.com/
# Enable the domain allowlist there so they cannot be reused from other sites.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
